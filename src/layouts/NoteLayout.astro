---
import ImageLightbox from '@/components/ImageLightbox.astro';
import ReadingHud from '@/components/ReadingHud.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ArticleHeading } from '@/lib/article-experience';
import { formatLocalizedDate, localizedPath } from '@/lib/i18n';
import { getMessages } from '@/i18n/messages';
import { slugifyTaxonomy } from '@/lib/urls';
import type { Locale } from '@/i18n/config';

interface Props {
  data: {
    canonicalPath: string;
    categories: string[];
    excerpt: string;
    publishedAt: Date;
    source: { url: string | null };
    sourceLinks: string[];
    tags: string[];
    title: string;
    updatedAt: Date;
    editorialStatus: 'review' | 'published' | 'excluded';
  };
  headings: ArticleHeading[];
  relatedNotes: Array<{
    data: {
      canonicalPath: string;
      excerpt: string;
      publishedAt: Date;
      title: string;
    };
  }>;
  relatedPosts: Array<{
    data: {
      canonicalPath: string;
      excerpt: string;
      publishedAt: Date;
      title: string;
    };
  }>;
  readingMinutes: number;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
  originalFacebookTagline?: string;
  sourceCanonicalPath?: string;
  translationKey?: string;
}

const { data, headings, relatedNotes, relatedPosts, readingMinutes } =
  Astro.props;
const locale = Astro.props.locale ?? 'zh-hant';
const originalFacebookTagline = Astro.props.originalFacebookTagline;
const sourceCanonicalPath = Astro.props.sourceCanonicalPath;
const alternates = Astro.props.alternates;
const t = getMessages(locale).note;
const hasTableOfContents = headings.length >= 3;
const isReview = data.editorialStatus === 'review';
const sourceLinkLabel = (href: string): string => {
  try {
    return new URL(href).hostname.replace(/^www\./u, '');
  } catch {
    return href;
  }
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  canonicalPath={data.canonicalPath}
  locale={locale}
  translationKey={locale === 'en' ? Astro.props.translationKey : undefined}
  alternates={alternates ??
    (locale === 'en' && sourceCanonicalPath
      ? { 'zh-hant': sourceCanonicalPath, en: data.canonicalPath }
      : undefined)}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  noindex={isReview}
>
  <div class="reading-progress" aria-hidden="true">
    <span></span>
  </div>

  <article class="article note-article">
    <header class="article__header shell shell--article">
      <div class="eyebrow">{t.eyebrow}</div>
      <h1>{data.title}</h1>
      {data.excerpt && <p class="article__dek">{data.excerpt}</p>}
      <div class="article__byline">
        <span>{t.originalFacebookByline}</span>
        {
          originalFacebookTagline && (
            <span class="article__source-tagline">
              {locale === 'en'
                ? `Original Chinese Facebook tagline: ${originalFacebookTagline}`
                : originalFacebookTagline}
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <time datetime={data.publishedAt.toISOString()}>
          {formatLocalizedDate(data.publishedAt, locale)}
        </time>
        <span aria-hidden="true">·</span>
        <span
          >{
            locale === 'en'
              ? `${readingMinutes} min read`
              : `約 ${readingMinutes} 分鐘`
          }</span
        >
        {
          data.updatedAt.getTime() !== data.publishedAt.getTime() && (
            <span class="article__updated">
              {locale === 'en'
                ? t.organizedAt(formatLocalizedDate(data.updatedAt, locale))
                : t.organizedAt(formatLocalizedDate(data.updatedAt, locale))}
            </span>
          )
        }
      </div>
      {
        isReview && (
          <aside
            class="note-review-banner"
            aria-label={locale === 'en' ? 'Editorial status' : '編輯狀態'}
          >
            {locale === 'en'
              ? 'This is a local review draft and is not included in the public content index.'
              : '這是本地審核草稿，尚未列入正式內容索引。'}
          </aside>
        )
      }
    </header>

    <div
      class:list={[
        'article__reading-shell',
        'shell',
        { 'article__reading-shell--single': !hasTableOfContents },
      ]}
    >
      <ReadingHud headings={headings} />

      <div class="article__content">
        <div class="note-source-card">
          <div>
            <strong>{t.sourceHeading}</strong>
            <p>
              {t.sourceContext}
            </p>
          </div>
          {
            data.source.url && (
              <a
                class="note-source-card__link"
                href={data.source.url}
                rel="noopener noreferrer"
              >
                <span>{t.viewOriginal}</span>
                <span class="note-source-card__url">{data.source.url}</span>
              </a>
            )
          }
        </div>

        <div class="prose">
          <slot />
        </div>

        {
          data.sourceLinks.length > 0 && (
            <section class="note-links" aria-labelledby="note-links-title">
              <h2 id="note-links-title">{t.mentionedLinks}</h2>
              <ul>
                {data.sourceLinks.map((href) => (
                  <li>
                    <a href={href} rel="noopener noreferrer">
                      {sourceLinkLabel(href)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (data.categories.length > 0 || data.tags.length > 0) && (
            <footer class="article__taxonomy">
              {data.categories.length > 0 && (
                <div>
                  <strong>{t.categories}</strong>
                  <ul>
                    {data.categories.map((category) => (
                      <li>
                        <a
                          href={localizedPath(
                            `/categories/${slugifyTaxonomy(category)}.html`,
                            locale,
                          )}
                        >
                          {category}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {data.tags.length > 0 && (
                <div>
                  <strong>{t.tags}</strong>
                  <ul>
                    {data.tags.map((tag) => (
                      <li>
                        <a
                          href={localizedPath(
                            `/tags/${slugifyTaxonomy(tag)}.html`,
                            locale,
                          )}
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </footer>
          )
        }

        <RelatedContent
          locale={locale}
          notes={relatedNotes}
          posts={relatedPosts}
        />
      </div>
    </div>
  </article>
  <ImageLightbox locale={locale} />
</BaseLayout>
