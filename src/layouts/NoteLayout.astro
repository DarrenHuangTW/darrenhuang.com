---
import type { CollectionEntry } from 'astro:content';
import ImageLightbox from '@/components/ImageLightbox.astro';
import ReadingHud from '@/components/ReadingHud.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { ArticleHeading } from '@/lib/article-experience';
import { formatDate } from '@/lib/content';
import { slugifyTaxonomy, withBase } from '@/lib/urls';

interface Props {
  data: CollectionEntry<'notes'>['data'];
  headings: ArticleHeading[];
  relatedNotes: CollectionEntry<'notes'>[];
  relatedPosts: CollectionEntry<'posts'>[];
  readingMinutes: number;
}

const { data, headings, relatedNotes, relatedPosts, readingMinutes } =
  Astro.props;
const hasTableOfContents = headings.length >= 3;
const isReview = data.editorialStatus === 'review';
const sourceLinkLabel = (href: string): string => {
  try {
    return new URL(href).hostname.replace(/^www\./u, '');
  } catch {
    return href;
  }
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  canonicalPath={data.canonicalPath}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  noindex={isReview}
>
  <div class="reading-progress" aria-hidden="true">
    <span></span>
  </div>

  <article class="article note-article">
    <header class="article__header shell shell--article">
      <div class="eyebrow">數位引擎筆記 · Facebook 保存</div>
      <h1>{data.title}</h1>
      {data.excerpt && <p class="article__dek">{data.excerpt}</p>}
      <div class="article__byline">
        <span>原始分享於數位引擎 Facebook</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.publishedAt.toISOString()}>
          {formatDate(data.publishedAt)}
        </time>
        <span aria-hidden="true">·</span>
        <span>約 {readingMinutes} 分鐘</span>
        {
          data.updatedAt.getTime() !== data.publishedAt.getTime() && (
            <span class="article__updated">
              整理於 {formatDate(data.updatedAt)}
            </span>
          )
        }
      </div>
      {
        isReview && (
          <aside class="note-review-banner" aria-label="編輯狀態">
            這是本地審核草稿，尚未列入正式內容索引。
          </aside>
        )
      }
    </header>

    <div
      class:list={[
        'article__reading-shell',
        'shell',
        { 'article__reading-shell--single': !hasTableOfContents },
      ]}
    >
      <ReadingHud headings={headings} />

      <div class="article__content">
        <div class="note-source-card">
          <div>
            <strong>來源註記</strong>
            <p>
              這篇內容保留 Facebook
              貼文的原始脈絡，部分工具、介面與外部連結可能已經改變。
            </p>
          </div>
          {
            data.source.url && (
              <a href={data.source.url} rel="noopener noreferrer">
                查看原始貼文 <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>

        <div class="prose">
          <slot />
        </div>

        {
          data.sourceLinks.length > 0 && (
            <section class="note-links" aria-labelledby="note-links-title">
              <h2 id="note-links-title">原文提到的連結</h2>
              <ul>
                {data.sourceLinks.map((href) => (
                  <li>
                    <a href={href} rel="noopener noreferrer">
                      {sourceLinkLabel(href)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (data.categories.length > 0 || data.tags.length > 0) && (
            <footer class="article__taxonomy">
              {data.categories.length > 0 && (
                <div>
                  <strong>分類</strong>
                  <ul>
                    {data.categories.map((category) => (
                      <li>
                        <a
                          href={withBase(
                            `/categories/${slugifyTaxonomy(category)}.html`,
                          )}
                        >
                          {category}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {data.tags.length > 0 && (
                <div>
                  <strong>標籤</strong>
                  <ul>
                    {data.tags.map((tag) => (
                      <li>
                        <a
                          href={withBase(`/tags/${slugifyTaxonomy(tag)}.html`)}
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </footer>
          )
        }

        <RelatedContent notes={relatedNotes} posts={relatedPosts} />
      </div>
    </div>
  </article>
  <ImageLightbox />
</BaseLayout>
