---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import WebMcpTools from '@/components/WebMcpTools.astro';
import {
  googleTagManagerBootstrapScript,
  isProductionTrackingTarget,
} from '@/lib/tracking';
import { markdownPathForCanonical, withBase } from '@/lib/urls';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string | null;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'article' | 'website';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const {
  title,
  description = '數位行銷、SEO、內容策略與科技趨勢的長期觀察。',
  canonicalPath = Astro.url.pathname,
  image,
  structuredData,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;

const siteName = '數位引擎';
const pageTitle = title === siteName ? title : `${title}｜${siteName}`;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(withBase(canonicalPath), siteOrigin);
const socialImagePath =
  image === undefined
    ? '/images/about/google-product-experts-summit-2018.webp'
    : image;
const imageUrl = socialImagePath
  ? new URL(withBase(socialImagePath), siteOrigin)
  : null;
const llmsUrl = new URL(withBase('/llms.txt'), siteOrigin);
const apiCatalogUrl = new URL(withBase('/.well-known/api-catalog'), siteOrigin);
const mcpServerCardUrl = new URL(
  withBase('/.well-known/mcp/server-card.json'),
  siteOrigin,
);
const agentSkillsUrl = new URL(
  withBase('/.well-known/agent-skills/index.json'),
  siteOrigin,
);
const markdownUrl = noindex
  ? null
  : new URL(withBase(markdownPathForCanonical(canonicalPath)), siteOrigin);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData)
  : null;
const safeStructuredData = serializedStructuredData
  ?.replaceAll('<', '\\u003c')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
const trackingEnabled = isProductionTrackingTarget(
  Astro.site,
  import.meta.env.PROD,
  import.meta.env.BASE_URL,
);
const googleTagManagerBootstrap = trackingEnabled
  ? googleTagManagerBootstrapScript()
  : null;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    {
      googleTagManagerBootstrap && (
        <script
          data-site-tracking="gtm"
          is:inline
          set:html={googleTagManagerBootstrap}
        />
      )
    }
    <meta name="viewport" content="width=device-width" />
    <meta
      name="theme-color"
      content="#f4f1e9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0e1514"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Darren Huang" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" href={llmsUrl} type="text/plain" />
    <link
      rel="api-catalog"
      href={apiCatalogUrl}
      type="application/linkset+json"
    />
    <link rel="describedby" href={agentSkillsUrl} type="application/json" />
    <link rel="describedby" href={mcpServerCardUrl} type="application/json" />
    {
      markdownUrl && (
        <link
          rel="alternate"
          href={markdownUrl}
          type="text/markdown"
          title={`${pageTitle}（Markdown）`}
        />
      )
    }
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      href={withBase('/rss.xml')}
      type="application/rss+xml"
      title="數位引擎 RSS"
    />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:alt" content="Darren Huang｜數位引擎" />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    {
      safeStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={safeStructuredData}
        />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <WebMcpTools />
  </body>
</html>
