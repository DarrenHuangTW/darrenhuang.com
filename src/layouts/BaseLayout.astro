---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import WebMcpTools from '@/components/WebMcpTools.astro';
import { DEFAULT_LOCALE, LOCALE_METADATA, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import { interfaceAlternates, localizedPath } from '@/lib/i18n';
import {
  googleTagManagerBootstrapScript,
  isProductionTrackingTarget,
} from '@/lib/tracking';
import { markdownPathForCanonical, withBase } from '@/lib/urls';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string | null;
  imageAlt?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'article' | 'website';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
  translationKey?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image,
  imageAlt,
  structuredData,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  locale = DEFAULT_LOCALE,
  alternates = {},
  translationKey,
} = Astro.props;

const localeMetadata = LOCALE_METADATA[locale];
const t = getMessages(locale);
const siteName = localeMetadata.siteName;
const brandedSiteName = `${siteName} ${localeMetadata.brandByline}`;
const pageTitle = t.baseLayout.pageTitle(title, siteName);
const localizedDescription = description ?? t.baseLayout.defaultDescription;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(withBase(canonicalPath), siteOrigin);
const socialImagePath =
  image === undefined
    ? '/images/about/google-product-experts-summit-2018.webp'
    : image;
const imageUrl = socialImagePath
  ? new URL(withBase(socialImagePath), siteOrigin)
  : null;
const socialImageAlt = imageAlt?.trim() || t.baseLayout.defaultOgImageAlt;
const llmsUrl = new URL(localizedPath('/llms.txt', locale), siteOrigin);
const apiCatalogUrl = new URL(withBase('/.well-known/api-catalog'), siteOrigin);
const mcpServerCardUrl = new URL(
  withBase('/.well-known/mcp/server-card.json'),
  siteOrigin,
);
const agentSkillsUrl = new URL(
  withBase('/.well-known/agent-skills/index.json'),
  siteOrigin,
);
const markdownUrl = noindex
  ? null
  : new URL(withBase(markdownPathForCanonical(canonicalPath)), siteOrigin);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData)
  : null;
const safeStructuredData = serializedStructuredData
  ?.replaceAll('<', '\\u003c')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
const trackingEnabled = isProductionTrackingTarget(
  Astro.site,
  import.meta.env.PROD,
  import.meta.env.BASE_URL,
);
const googleTagManagerBootstrap = trackingEnabled
  ? googleTagManagerBootstrapScript()
  : null;
const inferredAlternates = interfaceAlternates(canonicalPath);
const effectiveAlternates = {
  ...inferredAlternates,
  ...alternates,
  [locale]: canonicalPath,
};
const alternateUrls = Object.entries(effectiveAlternates)
  .filter((entry): entry is [Locale, string] => Boolean(entry[1]))
  .map(([alternateLocale, pathname]) => ({
    href: new URL(withBase(pathname), siteOrigin),
    hreflang: LOCALE_METADATA[alternateLocale].htmlLang,
    locale: alternateLocale,
  }));
const hasTranslationCluster = alternateUrls.length > 1;
const xDefaultUrl = alternateUrls.find(
  (alternate) => alternate.locale === 'en',
)?.href;
---

<!doctype html>
<html
  lang={localeMetadata.htmlLang}
  data-page-locale={locale}
  data-translation-key={translationKey}
>
  <head>
    <meta charset="UTF-8" />
    {
      googleTagManagerBootstrap && (
        <script
          data-site-tracking="gtm"
          is:inline
          set:html={googleTagManagerBootstrap}
        />
      )
    }
    <meta name="viewport" content="width=device-width" />
    <meta
      name="theme-color"
      content="#f4f1e9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0e1514"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={localizedDescription} />
    <meta name="author" content="Darren Huang" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {
      hasTranslationCluster &&
        alternateUrls.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate.hreflang}
            href={alternate.href}
          />
        ))
    }
    {
      hasTranslationCluster && xDefaultUrl && (
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      )
    }
    <link rel="describedby" href={llmsUrl} type="text/plain" />
    <link
      rel="api-catalog"
      href={apiCatalogUrl}
      type="application/linkset+json"
    />
    <link rel="describedby" href={agentSkillsUrl} type="application/json" />
    <link rel="describedby" href={mcpServerCardUrl} type="application/json" />
    {
      markdownUrl && (
        <link
          rel="alternate"
          href={markdownUrl}
          type="text/markdown"
          title={t.baseLayout.markdownAlternateTitle(pageTitle)}
        />
      )
    }
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      href={localizedPath('/rss.xml', locale)}
      type="application/rss+xml"
      title={t.baseLayout.rssTitle}
    />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta property="og:locale" content={localeMetadata.ogLocale} />
    {
      alternateUrls
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => (
          <meta
            property="og:locale:alternate"
            content={LOCALE_METADATA[alternate.locale].ogLocale}
          />
        ))
    }
    <meta property="og:site_name" content={brandedSiteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={localizedDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:alt" content={socialImageAlt} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={localizedDescription} />
    {imageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    {
      safeStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={safeStructuredData}
        />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t.baseLayout.skipToMain}
    </a>
    <SiteHeader locale={locale} alternates={effectiveAlternates} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <WebMcpTools locale={locale} />
  </body>
</html>
