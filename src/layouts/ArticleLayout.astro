---
import type { CollectionEntry } from 'astro:content';
import ArticleJourney from '@/components/ArticleJourney.astro';
import ImageLightbox from '@/components/ImageLightbox.astro';
import ReadingHud from '@/components/ReadingHud.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type {
  ArticleHeading,
  ArticleJourney as Journey,
} from '@/lib/article-experience';
import { transitionNameForPost } from '@/lib/article-experience';
import { formatLocalizedDate, localizedPath } from '@/lib/i18n';
import type { LocalizedPostData } from '@/lib/localized-content';
import { slugifyTaxonomy, withBase } from '@/lib/urls';

interface Props {
  alternates?: Partial<Record<Locale, string>>;
  data: CollectionEntry<'posts'>['data'] | LocalizedPostData;
  headings: ArticleHeading[];
  journey: Journey;
  locale?: Locale;
  relatedNotes: CollectionEntry<'notes'>[];
  readingMinutes: number;
}

const {
  alternates = {},
  data,
  headings,
  journey,
  locale = DEFAULT_LOCALE,
  relatedNotes,
  readingMinutes,
} = Astro.props;
const t = getMessages(locale);
const translationKey =
  'translationKey' in data ? data.translationKey : `post:${data.slug}`;
const isReviewDraft =
  'translationStatus' in data &&
  (data.translationStatus === 'draft' || data.translationStatus === 'review');
const titleDateRange = data.title.match(
  /^(.*[~～])(\d{4}[./-]\d{1,2}[./-]\d{1,2})$/u,
);
const hasTableOfContents = headings.length >= 3;
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  canonicalPath={data.canonicalPath}
  image={data.featuredMedia?.src}
  imageAlt={data.featuredMedia?.alt}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  noindex={isReviewDraft}
  locale={locale}
  alternates={alternates}
  translationKey={translationKey}
>
  <div class="reading-progress" aria-hidden="true">
    <span></span>
  </div>

  <article class="article">
    <header class="article__header shell shell--article">
      <div class="eyebrow">{t.article.eyebrow}</div>
      <h1 style={`view-transition-name: ${transitionNameForPost(data.slug)}`}>
        {
          titleDateRange ? (
            <>
              {titleDateRange[1]}
              <wbr />
              <span class="article__title-range-end">{titleDateRange[2]}</span>
            </>
          ) : (
            data.title
          )
        }
      </h1>
      {data.excerpt && <p class="article__dek">{data.excerpt}</p>}
      <div class="article__byline">
        <span>Darren Huang</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.publishedAt.toISOString()}
          >{formatLocalizedDate(data.publishedAt, locale)}</time
        >
        <span aria-hidden="true">·</span>
        <span>{t.article.readingTime(readingMinutes)}</span>
        {
          data.updatedAt.getTime() !== data.publishedAt.getTime() && (
            <span class="article__updated">
              {t.article.updatedAt(formatLocalizedDate(data.updatedAt, locale))}
            </span>
          )
        }
      </div>
    </header>

    {
      locale === 'en' && (
        <aside class="article__historical-notice" role="note">
          {t.article.historicalTranslationNotice(
            formatLocalizedDate(data.publishedAt, locale),
          )}
        </aside>
      )
    }

    {
      isReviewDraft && (
        <aside class="article__review-banner" role="status">
          {t.article.reviewBanner}
        </aside>
      )
    }

    {
      data.featuredMedia && (
        <figure class="article__hero shell">
          <img
            src={withBase(data.featuredMedia.src)}
            alt={data.featuredMedia.alt}
            width={data.featuredMedia.width}
            height={data.featuredMedia.height}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div
      class:list={[
        'article__reading-shell',
        'shell',
        { 'article__reading-shell--single': !hasTableOfContents },
      ]}
    >
      <ReadingHud headings={headings} locale={locale} />

      <div class="article__content">
        <div class="prose">
          <slot />
        </div>

        {
          (data.categories.length > 0 || data.tags.length > 0) && (
            <footer class="article__taxonomy">
              {data.categories.length > 0 && (
                <div>
                  <strong>{t.article.categories}</strong>
                  <ul>
                    {data.categories.map((category) => (
                      <li>
                        <a
                          href={localizedPath(
                            `/categories/${slugifyTaxonomy(category)}.html`,
                            locale,
                          )}
                        >
                          {category}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {data.tags.length > 0 && (
                <div>
                  <strong>{t.article.tags}</strong>
                  <ul>
                    {data.tags.map((tag) => (
                      <li>
                        <a
                          href={localizedPath(
                            `/tags/${slugifyTaxonomy(tag)}.html`,
                            locale,
                          )}
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </footer>
          )
        }

        <RelatedContent notes={relatedNotes} locale={locale} />

        <ArticleJourney journey={journey} locale={locale} />
      </div>
    </div>
  </article>
  <ImageLightbox locale={locale} />
</BaseLayout>

<style>
  .article__historical-notice,
  .article__review-banner {
    width: min(100% - 2rem, 50rem);
    margin: 1.25rem auto 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    background: var(--color-surface);
    font-size: 0.94rem;
  }

  .article__review-banner {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 45%,
      var(--color-line)
    );
  }
</style>
