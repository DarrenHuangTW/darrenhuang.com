---
import type { CollectionEntry } from 'astro:content';
import type { ArticleJourney as Journey } from '@/lib/article-experience';
import { formatDate } from '@/lib/content';
import { transitionNameForPost } from '@/lib/article-experience';
import { withBase } from '@/lib/urls';

interface Props {
  journey: Journey;
}

const { journey } = Astro.props;

function journeyCard(
  post: CollectionEntry<'posts'>,
  direction: 'next' | 'previous',
) {
  return {
    direction,
    href: withBase(post.data.canonicalPath),
    label: direction === 'previous' ? '上一期' : '下一期',
    post,
  };
}

const seriesCards = [
  journey.previous ? journeyCard(journey.previous, 'previous') : null,
  journey.next ? journeyCard(journey.next, 'next') : null,
].filter((card) => card !== null);
---

<section class="article-journey" aria-labelledby="article-journey-title">
  <header class="article-journey__header">
    <div>
      <div class="eyebrow">Keep exploring</div>
      <h2 id="article-journey-title">繼續閱讀</h2>
    </div>
    <a class="text-link" href={withBase('/articles.html')}>全部文章 →</a>
  </header>

  {
    seriesCards.length > 0 && (
      <nav
        class="article-journey__series"
        aria-label={`${journey.seriesLabel}系列導覽`}
      >
        {seriesCards.map(({ direction, href, label, post }) => (
          <a
            class:list={['journey-link', `journey-link--${direction}`]}
            href={href}
            data-astro-prefetch="hover"
          >
            <span>{label}</span>
            <strong>{post.data.title}</strong>
          </a>
        ))}
      </nav>
    )
  }

  {
    journey.related.length > 0 && (
      <div class="article-journey__related">
        <h3>相關文章</h3>
        <div class="related-grid">
          {journey.related.map((post) => (
            <article class="related-card">
              <time datetime={post.data.publishedAt.toISOString()}>
                {formatDate(post.data.publishedAt)}
              </time>
              <h4
                style={`view-transition-name: ${transitionNameForPost(post.data.slug)}`}
              >
                <a
                  href={withBase(post.data.canonicalPath)}
                  data-astro-prefetch="hover"
                >
                  {post.data.title}
                </a>
              </h4>
              <a
                class="text-link"
                href={withBase(post.data.canonicalPath)}
                data-astro-prefetch="hover"
                aria-label={`閱讀〈${post.data.title}〉`}
              >
                閱讀文章 <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    )
  }
</section>
