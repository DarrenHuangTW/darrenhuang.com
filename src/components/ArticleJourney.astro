---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import type {
  ArticleJourney as Journey,
  ArticlePost,
} from '@/lib/article-experience';
import { transitionNameForPost } from '@/lib/article-experience';
import { formatLocalizedDate, localizedPath } from '@/lib/i18n';
import { withBase } from '@/lib/urls';

interface Props {
  journey: Journey;
  locale?: Locale;
}

const { journey, locale = DEFAULT_LOCALE } = Astro.props;
const t = getMessages(locale);

function journeyCard(post: ArticlePost, direction: 'next' | 'previous') {
  return {
    direction,
    href: withBase(post.data.canonicalPath),
    label:
      direction === 'previous'
        ? t.articleJourney.previousIssue
        : t.articleJourney.nextIssue,
    post,
  };
}

const seriesCards = [
  journey.previous ? journeyCard(journey.previous, 'previous') : null,
  journey.next ? journeyCard(journey.next, 'next') : null,
].filter((card) => card !== null);
---

<section class="article-journey" aria-labelledby="article-journey-title">
  <header class="article-journey__header">
    <div>
      <div class="eyebrow">{t.articleJourney.eyebrow}</div>
      <h2 id="article-journey-title">{t.articleJourney.title}</h2>
    </div>
    <a class="text-link" href={localizedPath('/articles.html', locale)}
      >{t.articleJourney.allArticles} →</a
    >
  </header>

  {
    seriesCards.length > 0 && (
      <nav
        class="article-journey__series"
        aria-label={t.articleJourney.seriesAria(journey.seriesLabel ?? '')}
      >
        {seriesCards.map(({ direction, href, label, post }) => (
          <a
            class:list={['journey-link', `journey-link--${direction}`]}
            href={href}
            data-astro-prefetch="hover"
          >
            <span>{label}</span>
            <strong>{post.data.title}</strong>
          </a>
        ))}
      </nav>
    )
  }

  {
    journey.related.length > 0 && (
      <div class="article-journey__related">
        <h3>{t.articleJourney.relatedArticles}</h3>
        <div class="related-grid">
          {journey.related.map((post) => (
            <article class="related-card">
              <time datetime={post.data.publishedAt.toISOString()}>
                {formatLocalizedDate(post.data.publishedAt, locale)}
              </time>
              <h4
                style={`view-transition-name: ${transitionNameForPost(post.data.slug)}`}
              >
                <a
                  href={withBase(post.data.canonicalPath)}
                  data-astro-prefetch="hover"
                >
                  {post.data.title}
                </a>
              </h4>
              <a
                class="text-link"
                href={withBase(post.data.canonicalPath)}
                data-astro-prefetch="hover"
                aria-label={t.articleJourney.readArticleAria(post.data.title)}
              >
                {t.articleJourney.readArticle} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    )
  }
</section>
