---
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { DEFAULT_LOCALE, LOCALE_METADATA, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import { localizedPath } from '@/lib/i18n';

interface Props {
  alternates?: Partial<Record<Locale, string>>;
  locale?: Locale;
}

const { alternates = {}, locale = DEFAULT_LOCALE } = Astro.props;
const t = getMessages(locale);
const links = [
  { href: '/', label: t.navigation.home },
  { href: '/articles.html', label: t.navigation.articles },
  { href: '/notes.html', label: t.navigation.notes },
  { href: '/tags.html', label: t.navigation.tags },
  { href: '/about.html', label: t.navigation.about },
];

const currentPath = Astro.url.pathname;
const metadata = LOCALE_METADATA[locale];
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a
      class="brand"
      href={localizedPath('/', locale)}
      aria-label={t.navigation.homeAria}
      data-astro-prefetch="hover"
    >
      <span class="brand__mark" aria-hidden="true">數</span>
      <span>
        <strong>{metadata.siteName}</strong>
        <small>{metadata.brandByline}</small>
      </span>
    </a>

    <nav aria-label={t.navigation.primaryAria}>
      <ul class="site-nav">
        {
          links.map((link) => (
            <li>
              <a
                href={localizedPath(link.href, locale)}
                data-astro-prefetch="hover"
                aria-current={
                  currentPath === localizedPath(link.href, locale) ||
                  (link.href !== '/' &&
                    currentPath.startsWith(
                      localizedPath(link.href.replace(/\.html$/, ''), locale),
                    ))
                    ? 'page'
                    : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher locale={locale} alternates={alternates} />
  </div>
</header>
