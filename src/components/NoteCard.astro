---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import { formatLocalizedDate } from '@/lib/i18n';
import { withBase } from '@/lib/urls';

interface Props {
  note: {
    data: {
      canonicalPath: string;
      editorialStatus: 'review' | 'published' | 'excluded';
      excerpt: string;
      noteKind: 'historical' | 'reflection' | 'technical' | 'experiment';
      publishedAt: Date;
      title: string;
    };
  };
  locale?: Locale;
}

const { note, locale = DEFAULT_LOCALE } = Astro.props;
const t = getMessages(locale).cards.note;
const statusLabel =
  note.data.editorialStatus === 'review' ? t.statusReview : t.statusPublished;
---

<article class="note-card">
  <div class="note-card__meta">
    <time datetime={note.data.publishedAt.toISOString()}>
      {formatLocalizedDate(note.data.publishedAt, locale)}
    </time>
    <span>{statusLabel}</span>
  </div>
  <h2>
    <a href={withBase(note.data.canonicalPath)} data-astro-prefetch="hover">
      {note.data.title}
    </a>
  </h2>
  {note.data.excerpt && <p>{note.data.excerpt}</p>}
  <div class="note-card__footer">
    <span
      >{note.data.noteKind === 'historical' ? t.historical : t.siteNote}</span
    >
    <a
      class="text-link"
      href={withBase(note.data.canonicalPath)}
      data-astro-prefetch="hover"
      aria-label={t.readAria(note.data.title)}
    >
      {t.read}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
