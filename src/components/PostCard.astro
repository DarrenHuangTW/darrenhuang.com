---
import type { ArticlePost } from '@/lib/article-experience';
import { transitionNameForPost } from '@/lib/article-experience';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import { formatLocalizedDate } from '@/lib/i18n';
import { withBase } from '@/lib/urls';

interface Props {
  locale?: Locale;
  post: ArticlePost;
}

const { locale = DEFAULT_LOCALE, post } = Astro.props;
const t = getMessages(locale);
---

<article class="post-card">
  <div class="post-card__meta">
    <time datetime={post.data.publishedAt.toISOString()}
      >{formatLocalizedDate(post.data.publishedAt, locale)}</time
    >
    {post.data.categories[0] && <span>{post.data.categories[0]}</span>}
  </div>
  <h2 style={`view-transition-name: ${transitionNameForPost(post.data.slug)}`}>
    <a href={withBase(post.data.canonicalPath)} data-astro-prefetch="hover"
      >{post.data.title}</a
    >
  </h2>
  {post.data.excerpt && <p>{post.data.excerpt}</p>}
  <a
    class="text-link"
    href={withBase(post.data.canonicalPath)}
    data-astro-prefetch="hover"
    aria-label={t.cards.post.readAria(post.data.title)}
  >
    {t.cards.post.read}
    <span aria-hidden="true">→</span>
  </a>
</article>
