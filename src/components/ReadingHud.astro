---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import type { ArticleHeading } from '@/lib/article-experience';

interface Props {
  headings: ArticleHeading[];
  locale?: Locale;
}

const { headings, locale = DEFAULT_LOCALE } = Astro.props;
const t = getMessages(locale);
const visible = headings.length >= 3;
---

{
  visible && (
    <aside class="reading-hud">
      <details class="reading-hud__mobile">
        <summary>
          <span>{t.reading.tableOfContents.title}</span>
          <span aria-hidden="true">
            {t.reading.tableOfContents.sectionCount(headings.length)}
          </span>
        </summary>
        <nav aria-label={t.reading.tableOfContents.ariaLabel}>
          <ol>
            {headings.map((heading) => (
              <li
                class:list={{ 'reading-hud__subheading': heading.depth === 3 }}
              >
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>

      <nav
        class="reading-hud__desktop"
        aria-label={t.reading.tableOfContents.ariaLabel}
      >
        <strong>{t.reading.tableOfContents.title}</strong>
        <ol>
          {headings.map((heading) => (
            <li class:list={{ 'reading-hud__subheading': heading.depth === 3 }}>
              <a href={`#${heading.id}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}
