---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import { localizedPath } from '@/lib/i18n';
import { withBase } from '@/lib/urls';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getMessages(locale);
const year = new Date().getUTCFullYear();
const agentLinks = [
  {
    href: localizedPath('/developers.html', locale),
    label: t.footer.agentLinks.developersLabel,
    description: t.footer.agentLinks.developersDescription,
  },
  {
    href: localizedPath('/llms.txt', locale),
    label: 'llms.txt',
    description: t.footer.agentLinks.llmsDescription,
  },
  {
    href: withBase('/openapi.json'),
    label: 'OpenAPI 3.1',
    description: t.footer.agentLinks.apiDescription,
  },
  {
    href: withBase('/.well-known/mcp/server-card.json'),
    label: 'MCP Server Card',
    description: t.footer.agentLinks.mcpDescription,
  },
] as const;
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p>{t.footer.copyright(year)}</p>
    <nav aria-label={t.footer.navigationAria}>
      <a href={localizedPath('/rss.xml', locale)}>RSS</a>
      <a href={withBase('/sitemap-index.xml')}>Sitemap</a>
      <a href={localizedPath('/contact.html', locale)}>{t.footer.contact}</a>
      <a href={localizedPath('/privacy.html', locale)}>{t.footer.privacy}</a>
    </nav>
  </div>
  <nav
    class="shell site-footer__agent-nav"
    aria-labelledby="site-footer-agent-title"
  >
    <h2 id="site-footer-agent-title">{t.footer.developerHeading}</h2>
    <p>{t.footer.agentDescription}</p>
    <ul class="site-footer__agent-links">
      {
        agentLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
            <span>{link.description}</span>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>

<style>
  .site-footer__agent-nav {
    display: block;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .site-footer__agent-nav h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .site-footer__agent-nav > p {
    max-width: 48rem;
    margin: 0.45rem 0 1rem;
  }

  .site-footer__agent-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__agent-links li {
    display: grid;
    gap: 0.2rem;
  }

  .site-footer__agent-links a {
    color: var(--color-link);
    font-family: var(--font-sans);
    font-weight: 750;
  }

  .site-footer__agent-links span {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 40rem) {
    .site-footer__agent-links {
      grid-template-columns: 1fr;
    }
  }
</style>
