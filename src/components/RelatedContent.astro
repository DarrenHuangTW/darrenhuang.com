---
import type { CollectionEntry } from 'astro:content';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getMessages } from '@/i18n/messages';
import type { ArticlePost } from '@/lib/article-experience';
import { formatLocalizedDate } from '@/lib/i18n';
import { withBase } from '@/lib/urls';

interface Props {
  locale?: Locale;
  notes?: CollectionEntry<'notes'>[];
  posts?: ArticlePost[];
}

const { locale = DEFAULT_LOCALE, notes = [], posts = [] } = Astro.props;
const t = getMessages(locale);
const hasRelatedContent = notes.length > 0 || posts.length > 0;
---

{
  hasRelatedContent && (
    <section
      class="content-relations"
      aria-labelledby="content-relations-title"
    >
      <header class="content-relations__header">
        <div>
          <div class="eyebrow">{t.relatedContent.eyebrow}</div>
          <h2 id="content-relations-title">{t.relatedContent.title}</h2>
        </div>
      </header>
      <div class="content-relations__grid">
        {posts.map((post) => (
          <article class="content-relation-card">
            <div class="content-relation-card__type">
              {t.relatedContent.postType}
            </div>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatLocalizedDate(post.data.publishedAt, locale)}
            </time>
            <h3>
              <a
                href={withBase(post.data.canonicalPath)}
                data-astro-prefetch="hover"
              >
                {post.data.title}
              </a>
            </h3>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
          </article>
        ))}
        {notes.map((note) => (
          <article class="content-relation-card content-relation-card--note">
            <div class="content-relation-card__type">
              {t.relatedContent.noteType}
            </div>
            <time datetime={note.data.publishedAt.toISOString()}>
              {formatLocalizedDate(note.data.publishedAt, locale)}
            </time>
            <h3>
              <a
                href={withBase(note.data.canonicalPath)}
                data-astro-prefetch="hover"
              >
                {note.data.title}
              </a>
            </h3>
            {note.data.excerpt && <p>{note.data.excerpt}</p>}
          </article>
        ))}
      </div>
    </section>
  )
}
