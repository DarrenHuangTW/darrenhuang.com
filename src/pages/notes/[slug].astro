---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import NoteLayout from '@/layouts/NoteLayout.astro';
import { prepareArticleHtml } from '@/lib/article-experience';
import { getRelatedContentForNote } from '@/lib/content-relations';
import { getEnglishNoteRoutes } from '@/lib/localized-social';

export async function getStaticPaths() {
  const notes = await getCollection(
    'notes',
    ({ data }) => data.editorialStatus !== 'excluded',
  );

  return notes.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
await render(entry);
const prepared = prepareArticleHtml(
  entry.rendered?.html ??
    (() => {
      throw new Error(`Missing rendered HTML for ${entry.id}`);
    })(),
);
const relations = getRelatedContentForNote(
  entry,
  await getCollection('posts'),
  await getCollection('notes'),
);
const englishRoute = (await getEnglishNoteRoutes()).find(
  ({ source }) => source.data.slug === entry.data.slug,
);
---

<NoteLayout
  data={entry.data}
  headings={prepared.headings}
  relatedNotes={relations.notes}
  relatedPosts={relations.posts}
  readingMinutes={prepared.readingMinutes}
  alternates={englishRoute
    ? {
        'zh-hant': entry.data.canonicalPath,
        en: `/en/notes/${englishRoute.translation.data.slug}.html`,
      }
    : undefined}
>
  <Fragment set:html={prepared.html} />
</NoteLayout>
