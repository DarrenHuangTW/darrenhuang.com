---
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/urls';
import { getEnglishNoteRoutes } from '@/lib/localized-social';

const locale = 'en';
const t = getMessages(locale).notes;
const notes = (await getEnglishNoteRoutes()).toSorted(
  (left, right) =>
    right.source.data.publishedAt.getTime() -
    left.source.data.publishedAt.getTime(),
);
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath="/en/notes.html"
  locale={locale}
>
  <section class="section shell">
    <header class="section__header notes-directory__header">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
    </header>

    {
      notes.length > 0 ? (
        <div class="note-grid">
          {notes.map(({ translation, source }) => (
            <article class="note-card">
              <div class="note-card__meta">
                <time datetime={source.data.publishedAt.toISOString()}>
                  {source.data.publishedAt.toLocaleDateString('en-US', {
                    dateStyle: 'long',
                    timeZone: 'Asia/Taipei',
                  })}
                </time>
              </div>
              <h2>
                <a href={withBase(`/en/notes/${translation.data.slug}.html`)}>
                  {translation.data.title}
                </a>
              </h2>
              {translation.data.excerpt && <p>{translation.data.excerpt}</p>}
              <a
                class="text-link"
                href={withBase(`/en/notes/${translation.data.slug}.html`)}
              >
                Read note →
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>{t.translationPending}</p>
        </div>
      )
    }
    <a
      class="text-link"
      href={withBase('/notes.html')}
      hreflang="zh-Hant"
      lang="zh-Hant">{t.browseChinese} →</a
    >
  </section>
</BaseLayout>
