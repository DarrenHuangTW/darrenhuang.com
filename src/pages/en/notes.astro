---
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/urls';

const locale = 'en';
const t = getMessages(locale).notes;
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath="/en/notes.html"
  locale={locale}
>
  <section class="section shell">
    <header class="section__header notes-directory__header">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
    </header>

    <div class="empty-state">
      <p>{t.translationPending}</p>
      <a
        class="text-link"
        href={withBase('/notes.html')}
        hreflang="zh-Hant"
        lang="zh-Hant"
      >
        {t.browseChinese} →
      </a>
    </div>
  </section>
</BaseLayout>
