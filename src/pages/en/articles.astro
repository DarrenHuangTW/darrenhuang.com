---
import PostCard from '@/components/PostCard.astro';
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLocalizedPostsNewestFirst } from '@/lib/localized-content';

const locale = 'en';
const t = getMessages(locale);
const posts = await getLocalizedPostsNewestFirst(locale);
---

<BaseLayout
  title={t.articles.title}
  description={t.articles.description}
  canonicalPath="/en/articles.html"
  locale={locale}
>
  <section class="section shell">
    <header class="section__header">
      <div>
        <div class="eyebrow">{t.articles.eyebrow}</div>
        <h1>{t.articles.title}</h1>
        <p>{t.articles.count(posts.length)}</p>
      </div>
    </header>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
