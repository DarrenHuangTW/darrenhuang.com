---
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/urls';
import { getEnglishStoryRoutes } from '@/lib/localized-social';

const locale = 'en';
const t = getMessages(locale).webStories.index;
const stories = (await getEnglishStoryRoutes()).toSorted(
  (left, right) =>
    right.source.data.publishedAt.getTime() -
    left.source.data.publishedAt.getTime(),
);
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath="/en/web-stories.html"
  locale={locale}
>
  <section class="section shell">
    <header class="section__header">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
    </header>

    {
      stories.length > 0 ? (
        <div class="post-grid">
          {stories.map(({ translation, source }) => (
            <article class="post-card">
              <div class="post-card__meta">
                <time datetime={source.data.publishedAt.toISOString()}>
                  {source.data.publishedAt.toLocaleDateString('en-US', {
                    dateStyle: 'long',
                    timeZone: 'Asia/Taipei',
                  })}
                </time>
              </div>
              <h2>
                <a href={withBase(`/en/web-stories/${translation.data.slug}/`)}>
                  {translation.data.title}
                </a>
              </h2>
              <p>{translation.data.excerpt}</p>
              <a
                class="text-link"
                href={withBase(`/en/web-stories/${translation.data.slug}/`)}
              >
                Read story →
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>{t.translationPending}</p>
        </div>
      )
    }
    <a
      class="text-link"
      href={withBase('/web-stories.html')}
      hreflang="zh-Hant"
      lang="zh-Hant">{t.browseChinese} →</a
    >
  </section>
</BaseLayout>
