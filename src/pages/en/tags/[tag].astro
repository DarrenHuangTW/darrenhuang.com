---
import PostCard from '@/components/PostCard.astro';
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { taxonomyAlternates } from '@/lib/i18n';
import { getLocalizedPostsNewestFirst } from '@/lib/localized-content';
import { englishNoteView, getEnglishNoteRoutes } from '@/lib/localized-social';
import NoteCard from '@/components/NoteCard.astro';
import { slugifyTaxonomy } from '@/lib/urls';

export async function getStaticPaths() {
  const posts = await getLocalizedPostsNewestFirst('en');
  const notes = (await getEnglishNoteRoutes()).map(englishNoteView);
  const tags = new Map<string, { posts: typeof posts; notes: typeof notes }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const group = tags.get(tag) ?? { posts: [], notes: [] };
      group.posts.push(post);
      tags.set(tag, group);
    }
  }

  for (const note of notes) {
    for (const tag of note.data.tags) {
      const group = tags.get(tag) ?? { posts: [], notes: [] };
      group.notes.push(note);
      tags.set(tag, group);
    }
  }

  return [...tags.entries()].map(([tag, group]) => ({
    params: { tag: slugifyTaxonomy(tag) },
    props: { posts: group.posts, notes: group.notes, tag },
  }));
}

const locale = 'en';
const t = getMessages(locale);
const { posts, notes, tag } = Astro.props;
---

<BaseLayout
  title={t.taxonomy.tags.detailTitle(tag)}
  description={t.taxonomy.tags.detailDescription(tag)}
  canonicalPath={`/en/tags/${slugifyTaxonomy(tag)}.html`}
  locale={locale}
  alternates={taxonomyAlternates('tags', tag)}
>
  <section class="section shell">
    <header class="section__header">
      <div>
        <div class="eyebrow">Topic</div>
        <h1>{tag}</h1>
        <p>{t.taxonomy.tags.detailCount(posts.length + notes.length)}</p>
      </div>
    </header>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
    {
      notes.length > 0 && (
        <section
          class="taxonomy-content-group"
          aria-labelledby="tag-notes-title"
        >
          <header class="taxonomy-content-group__header">
            <h2 id="tag-notes-title">{t.taxonomy.tags.noteGroupTitle}</h2>
          </header>
          <div class="note-grid">
            {notes.map((note) => (
              <NoteCard note={note} locale={locale} />
            ))}
          </div>
        </section>
      )
    }
  </section>
</BaseLayout>
