---
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedPath } from '@/lib/i18n';
import { getLocalizedPostsNewestFirst } from '@/lib/localized-content';
import { englishNoteView, getEnglishNoteRoutes } from '@/lib/localized-social';
import { slugifyTaxonomy } from '@/lib/urls';

const locale = 'en';
const t = getMessages(locale);
const posts = await getLocalizedPostsNewestFirst(locale);
const notes = (await getEnglishNoteRoutes()).map(englishNoteView);
const counts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

for (const note of notes) {
  for (const tag of note.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].toSorted(
  (left, right) =>
    right[1] - left[1] || left[0].localeCompare(right[0], 'en-US'),
);
---

<BaseLayout
  title={t.taxonomy.tags.title}
  description={t.taxonomy.tags.description}
  canonicalPath="/en/tags.html"
  locale={locale}
>
  <section class="section shell">
    <header class="section__header">
      <div>
        <div class="eyebrow">{t.taxonomy.tags.eyebrow}</div>
        <h1>{t.taxonomy.tags.title}</h1>
        <p>{t.taxonomy.tags.intro}</p>
      </div>
    </header>
    <ul class="taxonomy-list">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={localizedPath(`/tags/${slugifyTaxonomy(tag)}.html`, locale)}
            >
              {tag} · {count}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
