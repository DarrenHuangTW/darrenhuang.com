---
import PostCard from '@/components/PostCard.astro';
import NoteCard from '@/components/NoteCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getPostsNewestFirst,
  getPublishedNotesNewestFirst,
} from '@/lib/content';
import { withBase } from '@/lib/urls';

const posts = await getPostsNewestFirst();
const recentPosts = posts.slice(0, 5);
const notes = await getPublishedNotesNewestFirst();
const recentNotes = notes.slice(0, 3);
const siteUrl = new URL(withBase('/'), Astro.site ?? Astro.url.origin);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: '數位引擎',
  alternateName: 'Darren Huang',
  url: siteUrl.toString(),
  logo: new URL(withBase('/favicon.svg'), siteUrl).toString(),
  description: '數位行銷、SEO、內容策略與科技趨勢的繁體中文長期觀察。',
  email: 'darrenhhuang@gmail.com',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'general inquiries',
    email: 'darrenhhuang@gmail.com',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kaohsiung',
    addressCountry: 'TW',
  },
  sameAs: ['https://www.facebook.com/searchenginecommunity/'],
};
---

<BaseLayout
  title="數位引擎"
  canonicalPath="/"
  structuredData={organizationSchema}
>
  <section class="hero shell">
    <div>
      <div class="hero__kicker">SEO · AI · Automation · UI／UX</div>
      <h1>讓寫過的內容，<em>繼續被找到</em></h1>
      <p class="hero__lede">
        我是 Darren Huang，一位轉換到 AI 賽道的 SEO 人。這裡收錄過去寫下的
        SEO、網站分析、Python、UI／UX
        與數位行銷文章，也留下一些關於數位產品與科技文化的觀察。
      </p>
    </div>
    <aside class="hero__panel">
      <strong>一些實作，一些觀察。</strong>
      <p>關於搜尋、內容、網站、產品，以及科技如何影響工作與生活。</p>
    </aside>
  </section>

  <section class="section section--surface" aria-labelledby="agent-interfaces">
    <div class="shell agent-interfaces">
      <div class="section__header">
        <div>
          <h2 id="agent-interfaces">給開發者與 Agent 的公開入口</h2>
          <p>
            如果你要研究數位引擎的公開內容，可以直接使用下列文件與唯讀介面，不需要登入、API
            key 或瀏覽器 JavaScript。
          </p>
        </div>
      </div>
      <ul class="agent-interfaces__list">
        <li>
          <a href={withBase('/developers.html')}>開發者與 Agent 入口</a>
          <span>快速了解 API、MCP、WebMCP 與版本政策。</span>
        </li>
        <li>
          <a href={withBase('/llms.txt')}>llms.txt</a>
          <span>網站定位、內容索引與 agent 使用說明。</span>
        </li>
        <li>
          <a href={withBase('/openapi.json')}>OpenAPI 3.1</a>
          <span>公開文章與保存筆記的唯讀 JSON API。</span>
        </li>
        <li>
          <a href={withBase('/.well-known/mcp/server-card.json')}
            >MCP Server Card</a
          >
          <span>公開 MCP endpoint 與兩個 read-only tools。</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--surface">
    <div class="shell">
      <div class="section__header">
        <div>
          <h2>文章紀錄</h2>
          <p>從搜尋與內容策略，到數位產品與科技文化。</p>
        </div>
        {
          posts.length > 0 && (
            <a class="text-link" href={withBase('/articles.html')}>
              查看全部 {posts.length} 篇 →
            </a>
          )
        }
      </div>

      {
        recentPosts.length > 0 ? (
          <div class="post-grid">
            {recentPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>內容正在匯入</h2>
            <p>Astro 架構已就緒，WordPress 文章會由可重跑 importer 產生。</p>
          </div>
        )
      }
    </div>
  </section>

  {
    recentNotes.length > 0 && (
      <section class="section">
        <div class="shell">
          <div class="section__header">
            <div>
              <h2>Facebook 保存筆記</h2>
              <p>
                把社群裡值得長期閱讀的觀察，整理成可以和文章互相參照的內容。
              </p>
            </div>
            <a class="text-link" href={withBase('/notes.html')}>
              查看全部 {notes.length} 篇 →
            </a>
          </div>
          <div class="note-grid">
            {recentNotes.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .agent-interfaces__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-interfaces__list li {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-line);
  }

  .agent-interfaces__list a {
    color: var(--color-link);
    font-family: var(--font-sans);
    font-weight: 750;
  }

  .agent-interfaces__list span {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 40rem) {
    .agent-interfaces__list {
      grid-template-columns: 1fr;
    }
  }
</style>
