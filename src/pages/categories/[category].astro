---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteCard from '@/components/NoteCard.astro';
import {
  getPostsNewestFirst,
  getPublishedNotesNewestFirst,
} from '@/lib/content';
import { slugifyTaxonomy } from '@/lib/urls';

export async function getStaticPaths() {
  const [posts, notes] = await Promise.all([
    getPostsNewestFirst(),
    getPublishedNotesNewestFirst(),
  ]);
  const categories = new Map<
    string,
    { notes: typeof notes; posts: typeof posts }
  >();

  for (const post of posts) {
    for (const category of post.data.categories) {
      const group = categories.get(category) ?? { notes: [], posts: [] };
      group.posts.push(post);
      categories.set(category, group);
    }
  }

  for (const note of notes) {
    for (const category of note.data.categories) {
      const group = categories.get(category) ?? { notes: [], posts: [] };
      group.notes.push(note);
      categories.set(category, group);
    }
  }

  return [...categories.entries()].map(([category, group]) => ({
    params: { category: slugifyTaxonomy(category) },
    props: { category, ...group },
  }));
}

const { category, notes, posts } = Astro.props;
---

<BaseLayout
  title={`分類：${category}`}
  description={`數位引擎的「${category}」分類文章。`}
  canonicalPath={`/categories/${slugifyTaxonomy(category)}.html`}
>
  <section class="section shell">
    <header class="section__header">
      <div>
        <div class="eyebrow">Category</div>
        <h1>{category}</h1>
        <p>共 {posts.length + notes.length} 篇文章與筆記。</p>
      </div>
    </header>
    {
      posts.length > 0 && (
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
    {
      notes.length > 0 && (
        <section
          class="taxonomy-content-group"
          aria-labelledby="category-notes-title"
        >
          <header class="taxonomy-content-group__header">
            <h2 id="category-notes-title">Facebook 保存筆記</h2>
          </header>
          <div class="note-grid">
            {notes.map((note) => (
              <NoteCard note={note} />
            ))}
          </div>
        </section>
      )
    }
  </section>
</BaseLayout>
