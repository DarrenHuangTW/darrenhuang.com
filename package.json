{
  "name": "darrenhuang.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "tsx scripts/build/agent-content.ts && tsx scripts/build/optimize-images.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "npm run typecheck:site && npm run typecheck:worker",
    "typecheck:site": "astro sync && tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p cloudflare/agent-readiness/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:worker": "vitest run --config cloudflare/agent-readiness/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:build": "wrangler deploy --dry-run --config cloudflare/agent-readiness/wrangler.jsonc --outfile .wrangler/agent-readiness-worker.js",
    "worker:deploy": "wrangler deploy --config cloudflare/agent-readiness/wrangler.jsonc",
    "worker:types": "wrangler types --config cloudflare/agent-readiness/wrangler.jsonc cloudflare/agent-readiness/worker-configuration.d.ts",
    "worker:types:check": "wrangler types --check --config cloudflare/agent-readiness/wrangler.jsonc cloudflare/agent-readiness/worker-configuration.d.ts",
    "audit:agent-readiness": "tsx scripts/audit/agent-readiness.ts",
    "migrate": "tsx scripts/migrate-wordpress/index.ts",
    "verify:dist": "tsx scripts/verify/dist.ts",
    "verify:migration": "tsx scripts/verify/migration.ts",
    "verify:production": "tsx scripts/verify/production.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@wordpress/block-serialization-default-parser": "^5.52.0",
    "astro": "^7.1.6",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "html-entities": "^2.6.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@truto/turndown-plugin-gfm": "^1.0.3",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "turndown": "^7.2.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
